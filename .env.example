# Copy this file to `.env` and fill in your local values.
# `.env` is gitignored and must never be committed.

# MySQL credentials — must match website/wp-config.php.
MYSQL_DATABASE=smitefrawcweb
MYSQL_USER=smitefrawcweb
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Hostname alias wp-config.php uses as DB_HOST.
MYSQL_HOST_ALIAS=smitefrawcweb.mysql.db

# Absolute path to the local WordPress installation (production mirror).
WORDPRESS_PATH=/path/to/website
